<style>
.compact-bib .col-sm-2.abbr { display: none; }
.compact-bib .author { display: none; }
.compact-bib .badges { display: none; }
.compact-bib .links { display: none; }
.compact-bib .title { display: inline; font-size: 0.92em; }
.compact-bib .periodical { display: inline; font-size: 0.85em; color: #666; }
.compact-bib .periodical:empty { display: none; }
html[data-theme="dark"] .compact-bib .periodical { color: #888; }
.compact-bib h2.bibliography { display: none; }
.compact-bib ol.bibliography { list-style-type: disc; padding-left: 1.5em; margin-bottom: 0; margin-top: 0.3em; }
.compact-bib ol.bibliography li { margin-bottom: 0.2em; padding-bottom: 0; padding-top: 0; border: none; line-height: 1.5; }
.compact-bib .row { margin-bottom: 0; padding-bottom: 0; }
.compact-bib .col-sm-8, .compact-bib .col-sm-10 { flex: 0 0 100%; max-width: 100%; }
.compact-bib .bibtex.hidden, .compact-bib .abstract.hidden { display: none; }
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.compact-bib .title').forEach(function(titleEl) {
    var li = titleEl.closest('li');
    if (!li) return;
    var htmlLink = li.querySelector('.links a[href*="://"]:not([href*=".pdf"])');
    var pdfLink = li.querySelector('.links a[href$=".pdf"], .links a[href*="/pdf/"]');
    var link = htmlLink || pdfLink;
    if (link) {
      var a = document.createElement('a');
      a.href = link.href;
      a.target = '_blank';
      a.rel = 'external nofollow noopener';
      a.innerHTML = titleEl.innerHTML;
      titleEl.innerHTML = '';
      titleEl.appendChild(a);
    }
  });
});
</script>
